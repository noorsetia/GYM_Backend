PORT=4000

# FRONTEND_URL used for CORS in development
FRONTEND_URL=http://localhost:5173

# SMTP settings (for Gmail use a 16-character App Password when 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your-email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Do NOT commit real credentials. Use your hosting provider's env vars for production.
